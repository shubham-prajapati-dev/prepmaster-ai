{
  "name": "prepmaster-ai",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT -c blue,green \"npm run dev --workspace=prepmaster-ai-server\" \"npm run dev --workspace=prepmaster-ai-client\"",
    "dev:client": "npm run dev --workspace=prepmaster-ai-client",
    "dev:server": "npm run dev --workspace=prepmaster-ai-server",
    "build": "npm run build --workspace=prepmaster-ai-client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}